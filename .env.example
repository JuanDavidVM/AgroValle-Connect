# Copie este archivo como ".env" (no se versiona) y complete los valores desde
# Supabase > Project Settings > Database > Connection string (pestaña JDBC).
SUPABASE_DB_URL=jdbc:postgresql://<HOST_SUPABASE>:5432/postgres?sslmode=require
SUPABASE_DB_USERNAME=<USUARIO_SUPABASE>
SUPABASE_DB_PASSWORD=<PASSWORD_DE_LA_BASE_DE_DATOS>
# Mínimo 32 caracteres
JWT_SECRET=<CLAVE_SECRETA_JWT_MIN_32_CARACTERES>
# Milisegundos (3600000 = 1 hora)
JWT_EXPIRATION=3600000
