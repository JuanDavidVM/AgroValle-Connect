#!/usr/bin/env sh

# Valida que el mensaje cumpla el estandar Conventional Commits.
# Formato: tipo(alcance opcional): descripcion en minuscula

PATRON='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._-]+\))?!?: .{10,}'

MENSAJE=$(head -n 1 "$1")

if ! echo "$MENSAJE" | grep -Eq "$PATRON"; then
  echo ""
  echo "COMMIT BLOQUEADO: el mensaje no cumple Conventional Commits."
  echo ""
  echo "  Recibido : $MENSAJE"
  echo "  Esperado : tipo(alcance): descripcion"
  echo ""
  echo "  Tipos validos: feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert"
  echo "  Ejemplo      : feat(auth): implementar registro de agricultores con validacion de cedula"
  echo ""
  exit 1
fi
